{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress-history.schema.json",
  "title": "AI English Coach Progress History",
  "description": "Schema for progress/history.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "sessionId",
        "level",
        "skills"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{6}Z$"
        },
        "level": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cefr",
            "confidence"
          ],
          "properties": {
            "cefr": {
              "enum": [
                "A1",
                "A2",
                "B1",
                "B2",
                "C1",
                "C2",
                null
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "cefr": {
                    "type": "null"
                  }
                },
                "required": [
                  "cefr"
                ]
              },
              "then": {
                "properties": {
                  "confidence": {
                    "const": 0
                  }
                }
              }
            }
          ]
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speaking",
            "listening",
            "grammar",
            "vocabulary",
            "pronunciation"
          ],
          "properties": {
            "speaking": {
              "$ref": "#/$defs/skill"
            },
            "listening": {
              "$ref": "#/$defs/skill"
            },
            "grammar": {
              "$ref": "#/$defs/skill"
            },
            "vocabulary": {
              "$ref": "#/$defs/skill"
            },
            "pronunciation": {
              "$ref": "#/$defs/skill"
            }
          }
        }
      }
    },
    "skill": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      ]
    }
  }
}
