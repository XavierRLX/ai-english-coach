{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "AI English Coach Review Queue",
  "description": "Schema for review/queue.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewItem"
      }
    }
  },
  "$defs": {
    "reviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "referenceId",
        "stage",
        "dueAt",
        "priority",
        "lastResult"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9:_-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "vocabulary",
            "mistake"
          ]
        },
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9:_-]*$"
        },
        "stage": {
          "type": "integer",
          "minimum": 0
        },
        "dueAt": {
          "type": "string",
          "format": "date"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "lastResult": {
          "enum": [
            "success",
            "failure",
            "partial",
            null
          ]
        }
      }
    }
  }
}
