{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progress.schema.json",
  "title": "AI English Coach Current Progress",
  "description": "Schema for progress/current.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "level",
    "stats",
    "skills",
    "focus",
    "strengths",
    "weaknesses",
    "lastSessionId"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cefr",
        "confidence"
      ],
      "properties": {
        "cefr": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "A1",
            "A2",
            "B1",
            "B2",
            "C1",
            "C2",
            null
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cefr": {
                "type": "null"
              }
            },
            "required": [
              "cefr"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionsCompleted",
        "totalMinutes"
      ],
      "properties": {
        "sessionsCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "totalMinutes": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaking",
        "listening",
        "grammar",
        "vocabulary",
        "pronunciation"
      ],
      "properties": {
        "speaking": {
          "$ref": "#/$defs/skill"
        },
        "listening": {
          "$ref": "#/$defs/skill"
        },
        "grammar": {
          "$ref": "#/$defs/skill"
        },
        "vocabulary": {
          "$ref": "#/$defs/skill"
        },
        "pronunciation": {
          "$ref": "#/$defs/skill"
        }
      }
    },
    "focus": {
      "$ref": "#/$defs/topicList"
    },
    "strengths": {
      "$ref": "#/$defs/topicList"
    },
    "weaknesses": {
      "$ref": "#/$defs/topicList"
    },
    "lastSessionId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{6}Z$"
        }
      ]
    }
  },
  "$defs": {
    "skill": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      ]
    },
    "topicList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
